PORT=3400
# login do painel (usuario:senha)
BASIC_AUTH=admin:troque-esta-senha
# chave que o n8n manda no header x-api-key
API_KEY=troque-esta-chave
# bot do BotFather (só ele, nenhum outro bot)
BOT_TOKEN=123456:ABC-DEF
# id do grupo de erros (-100...). Rode: node scripts/chatid.js
TG_CHAT_ID=
# n8n: uma URL por instância e uma chave na mesma ordem
N8N_BASE_URL=https://n8n2.eazy.tec.br,https://n8n.eazy.tec.br
N8N_API_KEY=chave-do-n8n2,chave-do-n8n
# Groq: análise dos erros, urgência, texto da correção e transcrição de voz
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
